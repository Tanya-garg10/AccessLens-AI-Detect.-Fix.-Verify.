# ─── AccessLens Backend — Environment Variables ───────────────────────────────
# Copy this to .env and fill in your values

# Server
PORT=4000

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# CORS — must match where your frontend is running
ALLOWED_ORIGIN="http://localhost:3000"

# OpenAI API Key — required for AI remediation proposals
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# OpenAI Model (optional — defaults to gpt-4o-mini for speed)
# OPENAI_MODEL="gpt-4o"

# Log level (optional): trace | debug | info | warn | error
# LOG_LEVEL="info"
